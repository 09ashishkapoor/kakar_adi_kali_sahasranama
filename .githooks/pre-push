#!/bin/sh
# Refuses to publish any commit that touches the vault or plain-text source.
# Runs on the whole outgoing range, so it also catches --no-verify commits.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

FORBIDDEN='(^|/)(private|_private|local-only|output_names)/|\.(txt|csv|tsv|dat)$'
ALLOW='^([^/]*/)*(robots|ai|llms|security|humans|ads|sitemap|LICENSE|CHANGELOG|CMakeLists|requirements[^/]*)\.txt$'
ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    commits=$(git rev-list "$local_sha")
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  [ -z "$commits" ] && continue
  fatal=0
  for c in $commits; do
    files=$(git show --pretty=format: --name-only "$c" | grep -E "$FORBIDDEN" | grep -Ev "$ALLOW" || true)
    if [ -n "$files" ]; then
      printf 'push blocked — %s is in commit %s:\n' "$remote_ref" "$(git log -1 --format=%h "$c")" >&2
      printf '%s\n' "$files" | sort -u | sed 's/^/  /' >&2
      fatal=1
    fi
  done
  if [ "$fatal" = 1 ]; then
    printf '\nSee AGENTS.md section 2. Nothing was pushed.\n' >&2
    exit 1
  fi
done

exit 0
