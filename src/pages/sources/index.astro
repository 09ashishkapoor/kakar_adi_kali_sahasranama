---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { SITE_URL } from '../../lib/site.js';

const canonical = `${SITE_URL}/sources/`;
const title = 'Sources and Editorial Notes | Kakar Adi Kali Sahasranama';
const description =
	'How the Kakar Adi Kali Sahasranama reference is presented, which public source material is acknowledged, and how corrections can be reported.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonical}#sources`,
	name: title,
	description,
	url: canonical,
	inLanguage: 'en',
};

const repo = 'https://github.com/09ashishkapoor/kakar_adi_kali_sahasranama';
const source = 'https://sanskritdocuments.org/doc_devii/kaaliisahasra.html';
---

<ReferenceLayout title={title} description={description} canonical={canonical} schema={schema}>
	<div class="page">
		<div class="narrow">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li aria-current="page">Sources</li>
				</ol>
			</nav>

			<p class="page-kicker">Project notes</p>
			<h1>Sources and Editorial Notes</h1>

			<section class="hero-panel">
				<p class="intro">
					This page explains how the Kakar Adi Kali Sahasranama reference is presented, what public source material
					is acknowledged, and how corrections can be reported.
				</p>
				<nav class="page-nav" aria-label="Source notes navigation">
					<ul>
						<li><a href="/">Open the interactive reader</a></li>
						<li><a href="/names/">Browse the static names hub</a></li>
						<li><a href="/kakaradi-kali-sahasranama/">What this text is</a></li>
					</ul>
				</nav>
			</section>

			<section class="source-notes" aria-labelledby="source-basis-heading">
				<h2 id="source-basis-heading">Source basis</h2>
				<p>
					This project compiles devotional source material and explanatory meaning notes for spiritual study,
					chanting support, and reference use.
				</p>
				<p>Primary public references used during compilation include:</p>
				<ul>
					<li><a href={source} rel="noopener noreferrer">SanskritDocuments.org — kakārādi kālī sahasranāma stotram</a></li>
				</ul>
				<p>
					The site presents a reader-friendly English reference and does not claim to replace traditional
					instruction, lineage guidance, or primary manuscript study.
				</p>
			</section>

			<section class="source-notes" aria-labelledby="source-note-heading">
				<h2 id="source-note-heading">About the Sanskrit edition</h2>
				<p>
					The text is the <em>kakārādi kālī sahasranāma stotram</em>, also known as the
					<em>kālī medhāsāmrājyaprada sahasranāma</em>. The edition says it comes from the
					<em>kālakālīkhaṇḍa</em> of the <em>mahākālasaṃhitā</em>; the Sanskrit Documents copy was proofread by
					Ravin Bhalekar, and the text is credited to tradition.
				</p>
				<p>
					Its opening line of names reads
					<span lang="sa">ॐ क्रीं काली क्रूँ कराली च कल्याणी कमला कला</span> — the same order as positions 1–7
					here.
				</p>
				<p class="callout">
					Sanskrit Documents publishes its files for personal study and research and asks that they not be copied
					or reposted. This site therefore links to the edition and cites it, but does not republish its Sanskrit.
					The names, transliterations and English commentary on these pages are this edition's own.
				</p>
			</section>

			<section class="source-notes" aria-labelledby="editorial-approach-heading">
				<h2 id="editorial-approach-heading">Editorial approach</h2>
				<ul>
					<li>The names are organized into a searchable homepage reader and crawlable static range pages.</li>
					<li>Each entry includes a short English meaning and a longer explanatory note where available.</li>
					<li>Static range pages and individual name pages are intended for citation because their content is visible without JavaScript.</li>
					<li>Spelling and transliteration choices are kept consistent within the project where possible.</li>
				</ul>
			</section>

			<section class="source-notes" aria-labelledby="transliteration-method-heading">
				<h2 id="transliteration-method-heading">Transliteration and name mapping</h2>
				<p>
					Every name is published with four forms: a common English spelling, an IAST transliteration, the
					Devanagari form, and the source transliteration used by this project. The common spelling is the
					romanization most readers type; alternate spellings are listed on each name page so the same name can be
					found under the forms different readers use.
				</p>
				<p>
					The spelling mapping is generated from the project data rather than hand-maintained per page. Repeated
					names in the Sahasranama share one canonical page that lists every occurrence.
				</p>
			</section>

			<section class="source-notes" aria-labelledby="corrections-heading">
				<h2 id="corrections-heading">Corrections and attribution</h2>
				<p>
					If you notice a spelling, meaning, formatting, attribution, or source issue, please report it through the
					open-source repository so the correction can be reviewed clearly.
				</p>
				<p>
					When citing this site, please attribute the material to <strong>Kakar Adi Kali Sahasranama</strong> and
					link to the relevant canonical page, such as the <a href="/names/">static names hub</a> or a specific
					name-range page.
				</p>
				<p><a href={repo} rel="noopener noreferrer">View the open-source repository</a></p>
			</section>
		</div>
	</div>
</ReferenceLayout>
