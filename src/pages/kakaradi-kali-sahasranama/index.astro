---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { getContent } from '../../lib/names.js';
import { SITE_URL } from '../../lib/site.js';

const { total, uniqueCount, ranges } = getContent();
const title = 'What Is the Kakar Adi Kali Sahasranama?';
const description =
	'The Kakar Adi Kali Sahasranama is a 1,000-name hymn to Maa Kali arranged in ten sets of one hundred. What it is, why devotees read it, and how to read it.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	url: `${SITE_URL}/kakaradi-kali-sahasranama/`,
	inLanguage: 'en',
	about: { '@type': 'Book', name: 'Kakar Adi Kali Sahasranama', numberOfPages: 1000, inLanguage: 'sa' },
};
---

<ReferenceLayout title={`${title} | Kakar Adi Kali Sahasranama`} description={description} canonical="/kakaradi-kali-sahasranama/" schema={schema} colophonLabel="What it is">
	<div class="page">
		<div class="narrow">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li aria-current="page">What it is</li>
				</ol>
			</nav>

			<p class="page-kicker">A thousand names, ten sets</p>
			<h1>What Is the Kakar Adi Kali Sahasranama?</h1>
			<p class="iast-title" lang="sa" style="font-size: clamp(18px, 2vw, 24px);">ककार आदि काली सहस्रनाम</p>
			<p class="common-title">Also written “Kakaradi Kali Sahasranama”</p>

			<section class="landing-section" aria-labelledby="what">
				<h2 class="sec" id="what"><span lang="sa">सहस्रनाम</span> A garland of a thousand names</h2>
				<div class="prose">
					<p class="drop">
						<strong>Sahasranama</strong> means a garland of one thousand names. The Kakar Adi Kali
						Sahasranama is a sacred stream of Ma Kali's names in which the sound <strong>ka</strong>
						becomes central — <em>kakarādi</em> means “beginning with the letter ka”. For devotees this is
						not only a list of titles. It is a way to approach the Mother through sound, meaning, form,
						symbol and inner power.
					</p>
					<p>
						The opening names carry the mood of mantra, sacred letters, divine creativity, compassion,
						lotus imagery, ritual action and direct seeing. The thousand together form one continuous
						hymn, divided into ten sets of one hundred so a reader can take it in measured portions
						instead of all at once.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="entries">
				<h2 class="sec" id="entries"><span lang="sa">रचना</span> What each entry holds</h2>
				<div class="prose">
					<p>
						Every one of the {total.toLocaleString('en-US')} positions has a page with four things kept
						together: the <strong>Devanagari</strong>, the <strong>IAST transliteration</strong>, the
						<strong>source transliteration</strong>, and an <strong>English meaning</strong>. Because
						Sanskrit reaches English through several romanizations, the alternate spellings are listed
						too, so the same name is findable as <em>Kali</em>, <em>Kālī</em> or <em>Kaali</em>.
					</p>
					<p>
						Names repeat. {uniqueCount} distinct names occupy the {total.toLocaleString('en-US')}
						positions, and a repeated name has one page listing every position it holds.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="why">
				<h2 class="sec" id="why"><span lang="sa">क्यों</span> Why devotees read this</h2>
				<div class="prose">
					<p>
						Many devotees want to understand what they are chanting. English meanings can support
						devotion by giving the heart a clear direction. Even when a name is kept in Sanskrit or
						romanized Sanskrit, the meaning helps the mind remember who is being invoked.
					</p>
					<p>
						This is especially useful for seekers who are beginning Kali upasana, studying Ma Kali's
						names, or learning to read the symbols of lotus, hand, action, sound and direct seeing that
						run through this sahasranama.
					</p>
					<p>
						The meanings here are devotional renderings, not a critical Sanskrit edition or a
						word-for-word translation. Their aim is to keep the reader with the <em>bhāva</em> of each
						name while holding the reverence and force of the text.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="read">
				<h2 class="sec" id="read"><span lang="sa">पाठ</span> How to read it</h2>
				<div class="prose">
					<p>
						You do not have to read all thousand at once. Some devotees read one small group each day;
						others stay with a single name until its meaning begins to work inwardly.
					</p>
					<p>
						Open any set and read straight through. The pager at the foot of each page moves to the next
						name in sequence. To find a name you only half remember, use the search on the
						<a class="u" href="/names/">index</a> — it ignores diacritics and accepts Devanagari, so
						<em>kali</em> matches <em>Kālī</em>, and काली matches as well.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="japa">
				<h2 class="sec" id="japa"><span lang="sa">जप</span> Carrying the names into japa</h2>
				<div class="callout">
					<p>
						If you want to carry these names into japa, the parampara's free app has an Adya Mahakali
						altar where you can <a href="https://mantrini.jaikhyapaparampara.com/" target="_blank" rel="noopener">count
						Adya Mahakali japa on MANTRINI</a> — offline, on a 108-bead mala, and the record stays on
						your device.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="faq">
				<h2 class="sec" id="faq"><span lang="sa">प्रश्न</span> Quick FAQ</h2>
				<div class="faq-list">
					<div class="faq-item">
						<h3>What is the Kakaradi Kali Sahasranama?</h3>
						<p>
							It is a sacred thousand-name hymn of Ma Kali in which the sound-current of the letter
							<strong>ka</strong> is central. Devotees use it for worship, japa, study and contemplation.
						</p>
					</div>
					<div class="faq-item">
						<h3>Are these all 1,000 names of Kali?</h3>
						<p>
							Yes — this edition carries all {total.toLocaleString('en-US')} positions. The opening 111
							names are also published as a standalone article on the
							<a href="https://jaikhyapaparampara.com/articles/kakaradi-kali-sahasranama-names-1-111-one-line-meanings/" target="_blank" rel="noopener">parampara site</a>.
						</p>
					</div>
					<div class="faq-item">
						<h3>Can I read these names in English for devotion?</h3>
						<p>
							Yes. English meanings can be used as a devotional aid, especially when you want to
							understand the qualities of Ma Kali being remembered through each name.
						</p>
					</div>
					<div class="faq-item">
						<h3>Is this a strict Sanskrit translation?</h3>
						<p>
							No. These are devotional one-line meanings meant for prayerful reading and contemplation,
							not a formal academic translation. The Devanagari and the transliterations are given for
							each name so the original is always in view.
						</p>
					</div>
					<div class="faq-item">
						<h3>Do I need Sanskrit to use it?</h3>
						<p>
							No. Every name carries a transliteration and a meaning. The Devanagari is there for
							readers who want the original script.
						</p>
					</div>
					<div class="faq-item">
						<h3>Can I copy it?</h3>
						<p>Yes. The text is free to read, print and share.</p>
					</div>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="structure">
				<h2 class="sec" id="structure"><span lang="sa">क्रम</span> The ten sets</h2>
				<ul class="range-list">
					{ranges.map((range) => (
						<li>
							<a class="tl" href={`/names/${range.slug}/`}>
								<span class="t">{range.start}–{range.end}</span>
								<span class="d"></span>
								<span class="p">{range.first.title} … {range.last.title}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</div>
	</div>
</ReferenceLayout>
