---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';
import { SITE_URL } from '../../lib/site.js';

const title = 'The book — coming later';
const description =
	'The printed book of the Kakar Adi Kali Sahasranama is in preparation. The full thousand names are already readable online, one page each.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	url: `${SITE_URL}/the-book/`,
	inLanguage: 'en',
};
---

<ReferenceLayout
	title={`${title} | Kakar Adi Kali Sahasranama`}
	description={description}
	canonical="/the-book/"
	schema={schema}
	robots="noindex,follow"
	colophonLabel="The book"
>
	<UnderConstruction
		kicker="Coming later"
		heading="The book"
		what="A bound, typeset edition of the thousand names is planned but not written yet. This page will carry it when it exists — nothing is being faked in the meantime."
		bullets={[
			'The full text is already online: <a class="u" href="/names/">all 1,000 names</a>, ten sets of one hundred.',
			'What the text is, and why devotees read it: <a class="u" href="/kakaradi-kali-sahasranama/">What Is the Kakar Adi Kali Sahasranama?</a>',
			'Printing from the browser works today: <a class="u" href="/kali-sahasranama-pdf/">print edition</a>.',
		]}
	/>
</ReferenceLayout>
