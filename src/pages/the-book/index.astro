---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { getContent } from '../../lib/names.js';
import { SITE_URL } from '../../lib/site.js';

const { total, uniqueCount, ranges } = getContent();
const title = 'The book — what the Kakar Adi Kali Sahasranama is';
const description =
	'The Kakar Adi Kali Sahasranama is a 1,000-name hymn to Maa Kali arranged in ten sets of one hundred. How it is ordered, how to read it, and what each entry contains.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	url: `${SITE_URL}/the-book/`,
	inLanguage: 'en',
	about: { '@type': 'Book', name: 'Kakar Adi Kali Sahasranama', numberOfPages: 1000, inLanguage: 'sa' },
};
---

<ReferenceLayout title={`${title} | Kakar Adi Kali Sahasranama`} description={description} canonical="/the-book/" schema={schema} colophonLabel="The book">
	<div class="page">
		<div class="narrow">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li aria-current="page">The book</li>
				</ol>
			</nav>

			<p class="page-kicker">A thousand names, ten sets</p>
			<h1>The book</h1>
			<p class="iast-title" lang="sa" style="font-size: clamp(18px, 2vw, 24px);">ककार आदि काली सहस्रनाम</p>

			<section class="landing-section" aria-labelledby="what">
				<h2 class="sec" id="what"><span lang="sa">परिचय</span> What it is</h2>
				<div class="prose">
					<p class="drop">
						The Kakar Adi Kali Sahasranama is a <strong>sahasranama</strong> — a “thousand names” —
						addressed to Maa Kali. Each name is a short Sanskrit epithet, and the thousand together
						form one continuous hymn. The title says how it is organised: <em>kakarādi</em>, “beginning
						with the letter <em>ka</em>”. The names run in the order of the alphabet from that first
						letter.
					</p>
					<p>
						The text is divided into ten sets of one hundred. Nothing about that division changes the
						words; it exists so a reader can take the hymn in measured portions instead of a thousand
						lines at once.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="entries">
				<h2 class="sec" id="entries"><span lang="sa">रचना</span> What each entry holds</h2>
				<div class="prose">
					<p>
						Every one of the {total.toLocaleString('en-US')} positions has a page with four things kept
						together: the <strong>Devanagari</strong>, the <strong>IAST transliteration</strong>, the
						<strong>source transliteration</strong>, and an <strong>English meaning</strong>. Because
						Sanskrit reaches English through several romanizations, the alternate spellings are listed
						too, so the same name is findable as <em>Kali</em>, <em>Kālī</em> or <em>Kaali</em>.
					</p>
					<p>
						Names repeat. {uniqueCount} distinct names occupy the {total.toLocaleString('en-US')} positions,
						and a repeated name has one page listing every position it holds.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="read">
				<h2 class="sec" id="read"><span lang="sa">पाठ</span> How to read it</h2>
				<div class="prose">
					<p>
						Open any set and read straight through. The pager at the foot of each page moves to the next
						name in sequence. If you prefer a paper copy, every page prints cleanly — the night theme
						forces itself back to ink on paper.
					</p>
					<p>
						To find a name you only half remember, use the search on the <a class="u" href="/names/">index</a>.
						It ignores diacritics and accepts Devanagari, so <em>kali</em> matches <em>Kālī</em>, and काली
						matches as well.
					</p>
				</div>
			</section>

			<section class="landing-section" aria-labelledby="structure">
				<h2 class="sec" id="structure"><span lang="sa">क्रम</span> The ten sets</h2>
				<ul class="range-list">
					{ranges.map((range) => (
						<li>
							<a class="tl" href={`/names/${range.slug}/`}>
								<span class="t">{range.start}–{range.end}</span>
								<span class="d"></span>
								<span class="p">{range.first.title} … {range.last.title}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="landing-section" aria-labelledby="faq">
				<h2 class="sec" id="faq"><span lang="sa">प्रश्न</span> Questions</h2>
				<div class="faq-list">
<div class="faq-item"><h3>Is this the same as the Kali Sahasranama?</h3><p>It is one recension of a Kali sahasranama. This edition follows a text whose names all begin
						with the letter <em>ka</em>, which is what <em>kakarādi</em> means — hence the title.</p></div>
<div class="faq-item"><h3>Do I need Sanskrit to use it?</h3><p>No. Every name carries a transliteration and a meaning. The Devanagari is there for readers
						who want the original script.</p></div>
<div class="faq-item"><h3>Can I copy it?</h3><p>Yes. The text is free to read, print and share.</p></div>
</div>
			</section>
		</div>
	</div>
</ReferenceLayout>
