---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import UnderConstruction from '../../components/UnderConstruction.astro';
import { SITE_URL } from '../../lib/site.js';

const title = 'Print edition — coming later';
const description =
	'The downloadable print edition of the Kakar Adi Kali Sahasranama is in preparation. Every page already prints cleanly from the browser.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	url: `${SITE_URL}/kali-sahasranama-pdf/`,
	inLanguage: 'en',
};
---

<ReferenceLayout
	title={`${title} | Kakar Adi Kali Sahasranama`}
	description={description}
	canonical="/kali-sahasranama-pdf/"
	schema={schema}
	robots="noindex,follow"
	colophonLabel="Print edition"
>
	<UnderConstruction
		kicker="Coming later"
		heading="Print edition"
		what="A typeset PDF of the whole thousand is planned but not produced yet. Until it exists, there is no download button here pretending to have one."
		bullets={[
			'Today, any name page or set prints on A4 with the night theme forced back to ink on cream — use your browser’s print command and choose “Save as PDF”.',
			'A range page prints as a two-column index, which is the cheapest paper copy of a hundred names.',
			'The ten-set contents prints as a one-page table of contents.',
		]}
	/>
</ReferenceLayout>
