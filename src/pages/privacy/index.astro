---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { SITE_URL } from '../../lib/site.js';

const canonical = `${SITE_URL}/privacy/`;
const title = 'Privacy Policy | Kakar Adi Kali Sahasranama';
const description =
	'This site has no accounts, no comments, no newsletter and no payments. What little data processing happens when you visit, explained plainly.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonical}#privacy`,
	name: title,
	description,
	url: canonical,
	inLanguage: 'en',
};

const repo = 'https://github.com/09ashishkapoor/kakar_adi_kali_sahasranama';
---

<ReferenceLayout title={title} description={description} canonical={canonical} schema={schema}>
	<div class="page">
		<div class="narrow">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li aria-current="page">Privacy</li>
				</ol>
			</nav>

			<p class="page-kicker">Site policy</p>
			<h1>Privacy Policy</h1>

			<section class="hero-panel">
				<p class="intro">
					This is a static devotional reference site. There are no accounts, no comments, no newsletter, and no
					payments. The information below explains the limited data processing that does happen when you visit.
				</p>
				<p class="intro">Last updated: 2026-11-19.</p>
			</section>

			<section class="source-notes">
				<h2>Analytics</h2>
				<p>
					This site runs no analytics, no tag manager and no advertising code. No cookies are set by these pages,
					and no advertising profiles are built.
				</p>
			</section>

			<section class="source-notes">
				<h2>Server logs and hosting</h2>
				<p>
					The site is hosted on Cloudflare Pages. Cloudflare processes standard request data (IP address, user
					agent, requested URL, timestamps) to serve and protect the site. See Cloudflare's privacy documentation
					for details of its processing.
				</p>
			</section>

			<section class="source-notes">
				<h2>Third-party links</h2>
				<p>
					Some pages link to external services, including Sanskrit Documents, the Khyapa Parampara site, the
					MANTRINI app, GitHub and Instagram. Those services have their own privacy policies once you leave this
					site.
				</p>
			</section>

			<section class="source-notes">
				<h2>Local data</h2>
				<p>
					The only thing stored on your device is your reading theme, under the key <code>kks-theme</code>. It is
					never sent anywhere. Browser caching keeps site files on your device for speed; clearing site data
					removes both.
				</p>
			</section>

			<section class="source-notes">
				<h2>Questions</h2>
				<p>
					Privacy questions can be raised through the <a href={repo} rel="noopener noreferrer">public repository</a>,
					preferably via a reviewable issue. If you are in a region with specific data-protection rights and need a
					more detailed response, include that in your message.
				</p>
			</section>
		</div>
	</div>
</ReferenceLayout>
