---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import { SITE_URL } from '../../lib/site.js';

const canonical = `${SITE_URL}/about/`;
const title = 'About the Project & Author | Kakar Adi Kali Sahasranama';
const description =
	'Kakar Adi Kali Sahasranama is a free devotional reference for the 1,000 names of Maa Kali, with English meanings, Devanagari spellings and transliteration.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	'@id': `${canonical}#about`,
	name: title,
	description,
	url: canonical,
	inLanguage: 'en',
};

const repo = 'https://github.com/09ashishkapoor/kakar_adi_kali_sahasranama';
---

<ReferenceLayout title={title} description={description} canonical={canonical} schema={schema} colophonLabel="About">
	<div class="page">
		<div class="narrow">
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li aria-current="page">About</li>
				</ol>
			</nav>

			<p class="page-kicker">About the project</p>
			<h1>About Kakar Adi Kali Sahasranama</h1>

			<figure class="page-figure">
				<picture>
					<source
						type="image/avif"
						srcset="/img/deity-480.avif 480w, /img/deity-800.avif 800w"
						sizes="(max-width: 760px) 100vw, 640px"
					/>
					<img
						src="/img/deity-800.webp"
						srcset="/img/deity-480.webp 480w, /img/deity-800.webp 800w"
						sizes="(max-width: 760px) 100vw, 640px"
						width="602"
						height="800"
						alt="Four-armed murti of Maa Kali, red-lit against black, trident and severed head in her upper hands."
						loading="lazy"
						decoding="async"
					/>
				</picture>
				<figcaption>Maa Kali — devotional image used on this site.</figcaption>
			</figure>

			<section class="hero-panel">
				<p class="intro">
					<strong>Kakar Adi Kali Sahasranama</strong> is a free devotional reference for the Kakar Adi Kali
					Sahasranama: 1,000 names of Maa Kali with English meanings, Devanagari spellings, and transliteration.
					It is maintained by <strong>Kaliputra Ashish</strong> and dedicated to
					<strong>Shri Praveen Radhakrishnan</strong> and the <strong>Khyapa Parampara</strong>.
				</p>
				<nav class="page-nav" aria-label="About navigation">
					<ul>
						<li><a href="/names/">Browse all names</a></li>
						<li><a href="/kakaradi-kali-sahasranama/">What this text is</a></li>
						<li><a href="/sources/">Sources and editorial method</a></li>
						<li><a href={repo} rel="noopener noreferrer">Repository</a></li>
					</ul>
				</nav>
			</section>

			<section class="source-notes">
				<h2>What this site is</h2>
				<p>
					The project exists to support devotional reading and study of the Kakar Adi Kali Sahasranama. It
					presents the full name list with one-line meanings and longer explanatory notes, a searchable reader, a
					static names hub, and a printable page. Everything is offered free, without registration.
				</p>
				<p>
					The site is intentionally simple and open: it is a static website with no accounts and no paywall, and
					its source code is public.
				</p>
			</section>

			<section class="source-notes">
				<h2>How the text was compiled</h2>
				<p>
					The names follow the Kakar Adi Kali Sahasranama as compiled for this project, checked against the
					Sanskrit edition hosted by Sanskrit Documents. Public reference material and the broader Shakta
					devotional tradition informed the explanatory notes. The English meanings and elaborations are
					interpretive study notes, not a translation of a single critical edition.
				</p>
				<p>
					The source basis, editorial approach, and citation guidance are documented on the
					<a href="/sources/">sources page</a>.
				</p>
			</section>

			<section class="source-notes">
				<h2>Transliteration approach</h2>
				<p>
					Sanskrit names reach English readers in several romanizations. Each name page shows a common English
					spelling, the IAST form, the Devanagari form, and the source transliteration used by this project. The
					mapping is generated from the site's data, so corrections are made once and applied across every page.
				</p>
				<p>
					If a spelling matters for your practice or citation, use the IAST or Devanagari form on the individual
					name page as the reference.
				</p>
			</section>

			<section class="source-notes">
				<h2>Open source and corrections</h2>
				<p>
					The site is open source. Spelling, meaning, formatting, attribution, and source issues can be reported
					through the public repository, which keeps the correction reviewable.
				</p>
				<p>
					<a href={repo} rel="noopener noreferrer">View the project repository</a>
				</p>
			</section>
		</div>
	</div>
</ReferenceLayout>
