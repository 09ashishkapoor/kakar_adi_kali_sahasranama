---
// The Pothi running head. Every page opens with this and closes with the
// colophon — that is what makes 1,000 pages read as one book.
import { SITE_DEV, SITE_LATIN } from '../lib/site.js';

const path = Astro.url.pathname;

const navItems = [
	{ label: 'Names', href: '/names/' },
	{ label: 'What it is', href: '/kakaradi-kali-sahasranama/' },
	{ label: 'Benefits', href: '/kali-sahasranama-benefits/' },
	{ label: 'About', href: '/about/' },
];

function isCurrent(href) {
	if (href === '/names/') return path === '/names/' || path.startsWith('/names/');
	return path === href || path.startsWith(href);
}
---

<header class="bar">
	<a class="brand" href="/" translate="no">
		<span class="dev" lang="sa">{SITE_DEV}</span>
		<span class="lat">{SITE_LATIN}</span>
	</a>
	<nav aria-label="Site">
		{navItems.map((item) => (
			<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
		))}
	</nav>
	<button class="theme" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to night reading">
		<span class="sw" aria-hidden="true"></span><span class="lbl">Night</span>
	</button>
</header>
